[Unit]
Description=rOS first boot setup
Documentation=https://github.com/togobeyond/rOS
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service
Before=getty@tty1.service
ConditionPathExists=/root/create-ros.sh
ConditionPathExists=/root/DATA

[Service]
Type=oneshot
WorkingDirectory=/root
Environment=TERM=linux
ExecStartPre=/bin/bash -c 'for i in {1..60}; do curl -sfI --max-time 3 http://mirror.archlinuxarm.org/ > /dev/null && exit 0; sleep 5; done; exit 1'
ExecStart=/bin/bash /root/create-ros.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
